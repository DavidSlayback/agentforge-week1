# Copy to .env.local (gitignored) for local development. Names only; never commit values.
PORT=8790
DASHBOARD_PUBLIC_ORIGIN=http://localhost:8790
# The OpenEMR OAuth issuer, exactly as its id tokens' `iss` (site_addr_oath + /oauth2/default).
DASHBOARD_OAUTH_ISSUER=https://localhost:9300/oauth2/default
# Server-side (token, JWKS, API) calls; http://openemr on the Docker network.
DASHBOARD_OPENEMR_INTERNAL_URL=http://localhost:8300
DASHBOARD_OAUTH_CLIENT_ID=
DASHBOARD_OAUTH_CLIENT_SECRET=
# At least 32 random characters; signs the session cookie.
DASHBOARD_SESSION_SECRET=
# OpenEMR's PHP timezone (the local stack runs UTC).
DASHBOARD_OPENEMR_TZ=UTC
# Optional: neutral label=<patient uuid> pairs for the landing page.
DASHBOARD_DEMO_PATIENTS=
