# Server-only values. Do not commit the populated file.
# Copy this file to a root-owned path on the Vultr VM and replace every value.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
SALT=REPLACE_WITH_LONG_RANDOM_VALUE
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
TELEMETRY_ENABLED=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE

REDIS_AUTH=REPLACE_WITH_LONG_RANDOM_VALUE

MINIO_ROOT_USER=REPLACE_WITH_LONG_RANDOM_VALUE
MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_EXTERNAL_ENDPOINT=http://localhost:9090

LANGFUSE_INIT_ORG_ID=agentforge-org
LANGFUSE_INIT_ORG_NAME=AgentForge
LANGFUSE_INIT_PROJECT_ID=agentforge
LANGFUSE_INIT_PROJECT_NAME=AgentForge operational traces
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=REPLACE_WITH_PROJECT_PUBLIC_KEY
LANGFUSE_INIT_PROJECT_SECRET_KEY=REPLACE_WITH_PROJECT_SECRET_KEY
LANGFUSE_INIT_USER_EMAIL=REPLACE_WITH_ADMIN_EMAIL
LANGFUSE_INIT_USER_NAME=AgentForge operator
LANGFUSE_INIT_USER_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
