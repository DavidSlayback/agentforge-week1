#!/bin/sh
# Enforced AgentForge gate. The GitLab project has no CI runner, so this hook
# is what blocks regressions; .gitlab-ci.yml mirrors it for when one exists.
# Install once per clone: git config --local core.hooksPath .githooks
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v node >/dev/null 2>&1; then
  echo "AgentForge gate requires Node.js 24 on PATH." >&2
  exit 1
fi

if [ ! -d agentforge/node_modules ] || [ agentforge/package-lock.json -nt agentforge/node_modules ]; then
  echo "AgentForge gate: installing locked dependencies..."
  npm ci --silent --prefix agentforge
fi

# oe-module-agentforge PHP: lint every file and run the dependency-free tests
# (shared HMAC vectors, replay, idempotency, dispatcher). Required when the
# commit touches the module; otherwise run when php is available.
module_dir=interface/modules/custom_modules/oe-module-agentforge
if git diff --cached --name-only | grep -q "^$module_dir/"; then
  php_required=1
else
  php_required=0
fi
if command -v php >/dev/null 2>&1; then
  echo "AgentForge gate: module PHP lint and tests..."
  find "$module_dir" -name '*.php' -print | while IFS= read -r php_file; do
    lint=$(php -l "$php_file" 2>&1) || { printf '%s\n' "$lint" >&2; exit 1; }
  done
  php_tests=$(php "$module_dir/tests/run.php" 2>&1) || { printf '%s\n' "$php_tests" >&2; exit 1; }
  printf '%s\n' "$php_tests" | tail -n 1
elif [ "$php_required" = 1 ]; then
  echo "AgentForge gate: this commit changes $module_dir; PHP 8.4 must be on PATH to lint and test it." >&2
  exit 1
else
  echo "AgentForge gate: SKIP module PHP checks (php not on PATH; no staged changes under $module_dir)."
fi

echo "AgentForge gate: unit suites..."
npm test --silent --prefix agentforge
npm test --silent --prefix evals
node --test observability/test/*.test.js >/dev/null

# deploy/vultr/deploy.sh: offline tests with fake ssh/docker/curl (keepalives,
# build before replace, detached build that survives a dropped session, SHA
# health loop). Mirrored by the deploy-script job in .gitlab-ci.yml.
echo "AgentForge gate: deploy.sh offline tests..."
deploy_tests=$(sh deploy/vultr/test/deploy.test.sh 2>&1) || { printf '%s\n' "$deploy_tests" >&2; exit 1; }
printf '%s\n' "$deploy_tests" | tail -n 1

# Patient dashboard port (dashboard/): typecheck, lint, unit/contract/BFF/
# component tests and the SPA build with its bundle budget. Mirrored by the
# dashboard-check job in .gitlab-ci.yml.
if [ ! -d dashboard/node_modules ] || [ dashboard/package-lock.json -nt dashboard/node_modules ]; then
  echo "Dashboard gate: installing locked dependencies..."
  npm ci --silent --prefix dashboard
fi

echo "Dashboard gate: typecheck, lint, unit/contract/component tests, build..."
npm run --silent --prefix dashboard check

echo "AgentForge gate: W2 50-case eval gate..."
node agentforge/scripts/run-w2-gate.mjs


# W2 extension suite (D12: the PRD p.5-6 extension items). Same judge,
# labels, per-label threshold and regression rule as the 50-case gate; the
# golden set itself stays at exactly 50. Mirrored in .gitlab-ci.yml.
echo "AgentForge gate: W2 extension suite..."
node agentforge/scripts/run-w2-extension-gate.mjs
