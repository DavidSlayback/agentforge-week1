meta {
  name: W1 demo context (signed synthetic token)
  type: http
  seq: 3
}

get {
  url: {{w1BaseUrl}}/v1/demo-context?patient_uuid={{patientUuid}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.patient_uuid: eq {{patientUuid}}
  res.body.synthetic_only: eq true
}

script:post-response {
  bru.setVar("w1Token", res.getBody().demo_token);
}

tests {
  test("issues a signed token", function () {
    expect(res.getBody().demo_token).to.match(/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/);
  });
}
