meta {
  name: W2 upload a one-page synthetic PDF (for the page image)
  type: http
  seq: 10
}

post {
  url: {{w2BaseUrl}}/v1/source-documents
  body: json
  auth: none
}

body:json {
  {
    "patient_uuid": "{{patientUuid}}",
    "clinician_uuid": "{{clinicianUuid}}",
    "demo_token": "{{w2WriteToken}}",
    "document_type": "lab_pdf",
    "filename": "bruno-synthetic-page.pdf",
    "content_base64": ""
  }
}

assert {
  res.status: eq 200
  res.body.status: eq persisted
}

script:post-response {
  bru.setVar("pdfSourceDocumentId", res.getBody().source_document.id);
}

docs {
  A hand-built one-page PDF with the text "SYNTHETIC TEST PAGE - NO PHI".
  The safe script sandbox cannot pass binary response bytes between
  requests, so the page-image check uploads this inline PDF instead of the
  /v1/demo-scan-pdf samples. It is never scanned (no model cost).
}
