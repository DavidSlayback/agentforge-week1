meta {
  name: W2 ready
  type: http
  seq: 2
}

get {
  url: {{w2BaseUrl}}/ready
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq ready
}

tests {
  test("every reported dependency is ready", function () {
    const dependencies = res.getBody().dependencies;
    expect(dependencies, "dependency states").to.be.an("object");
    const names = Object.keys(dependencies);
    expect(names.length).to.be.greaterThan(0);
    for (const name of names) expect(dependencies[name].status, name).to.equal("ready");
  });
}
